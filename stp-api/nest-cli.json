{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [{ "include": "assets/**/*", "watchAssets": true }],
    "watchOptions": {
      "usePolling": true,
      "interval": 1000
    }
  }
}

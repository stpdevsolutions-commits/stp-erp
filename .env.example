NODE_ENV=development
PORT=3001

# PostgreSQL — usar el mismo password en DATABASE_URL y POSTGRES_PASSWORD
POSTGRES_USER=stp_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=stp_db
DATABASE_URL=postgresql://stp_user:CHANGE_ME@stp-postgres:5432/stp_db

# Redis — usar el mismo password en REDIS_URL y REDIS_PASSWORD
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@stp-redis:6379

# JWT — generar con: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# CORS — orígenes del frontend (separar por coma), o * para cualquiera
CORS_ORIGINS=*

# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_EMAIL=noreply@stpsoluciones.com
ADMIN_EMAIL=admin@stpsoluciones.com

# URL pública del frontend (usado en emails de reset de contraseña y en el
# redirect final del login con Google)
APP_URL=https://erp.stpsoluciones.com

# ── Login con Google (OAuth 2.0) ──────────────────────────────────────────────
# Opcional: si estas credenciales NO están, las rutas /auth/google devuelven 401
# y el resto del login sigue funcionando normal.
# Crear en Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (tipo "Web application"). Authorized redirect URI EXACTO:
#   https://api.stpsoluciones.com/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=https://api.stpsoluciones.com/auth/google/callback
# Política de acceso: dominios cuyos emails pueden auto-crearse (coma-separado).
# '*' = cualquier dominio (úsalo solo si el gate real es la VPN). Vacío = ninguno.
GOOGLE_ALLOWED_DOMAINS=*
# Poner en 'true' para auto-crear cuentas (rol USER) de esos dominios; si es
# 'false' o falta, solo entran emails ya registrados en el ERP.
GOOGLE_AUTO_PROVISION=true
# Dominio de cookies para que la sesión seteada por la API (api.stpsoluciones.com)
# sea válida en el ERP (erp.stpsoluciones.com). Debe empezar con punto.
COOKIE_DOMAIN=.stpsoluciones.com

# ── Infraestructura ───────────────────────────────────────────────────────────

# Cloudflare
CF_DNS_API_TOKEN=CHANGE_ME
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# Nextcloud
NEXTCLOUD_DB_PASS=CHANGE_ME
COOKIE_SECURE=true

# Vaultwarden
# Generar hash con: docker run --rm -it vaultwarden/server /vaultwarden hash --preset owasp
# Rodear siempre con comillas simples en .env (el hash contiene $ que godotenv expande)
VAULTWARDEN_ADMIN_TOKEN='HASH_ARGON2ID_AQUI'
# SSO con Google — redirect URI: https://vault.stpsoluciones.com/identity/connect/oidc-signin
# Poner VAULT_SSO_ENABLED=true solo cuando CLIENT_ID y SECRET estén configurados
VAULT_SSO_ENABLED=false
VAULT_SSO_CLIENT_ID=CHANGE_ME
VAULT_SSO_CLIENT_SECRET=CHANGE_ME

# Headscale OIDC (Oracle Cloud)
HEADSCALE_OIDC_CLIENT_ID=CHANGE_ME
HEADSCALE_OIDC_CLIENT_SECRET=CHANGE_ME

# ── Nextcloud OIDC (Google) ───────────────────────────────────────────────────
# Redirect URI: https://cloud.stpsoluciones.com/index.php/apps/user_oidc/code
# Configurar con: scripts/setup-nextcloud-oidc.sh
NEXTCLOUD_OIDC_CLIENT_ID=CHANGE_ME
NEXTCLOUD_OIDC_CLIENT_SECRET=CHANGE_ME

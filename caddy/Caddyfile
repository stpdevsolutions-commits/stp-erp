{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

# ── Landing page — pública (Cloudflare maneja HTTPS, Caddy sirve HTTP) ────────
http://stpsoluciones.com, http://www.stpsoluciones.com {
	root * /srv/www
	file_server
}

# ── Apps privadas — HTTPS wildcard, solo VPN (100.64.0.0/10) o LAN (10.0.0.0/8 · 192.168.0.0/16)
*.stpsoluciones.com {
	tls {
		dns cloudflare {env.CF_DNS_API_TOKEN}
	}

	# ERP Frontend
	@erp {
		host erp.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @erp {
		reverse_proxy stp-landing:3000
	}

	# ERP API (NestJS — para app móvil y acceso directo)
	@api {
		host api.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @api {
		reverse_proxy stp-api:3001
	}

	# Vaultwarden
	@vaultwarden {
		host vault.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @vaultwarden {
		reverse_proxy stp-vaultwarden:80
	}

	# Nextcloud
	@nextcloud {
		host cloud.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @nextcloud {
		reverse_proxy stp-nextcloud:80
	}

	# Uptime Kuma
	@uptime {
		host status.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @uptime {
		reverse_proxy stp-uptime-kuma:3001
	}

	# AdGuard
	@adguard {
		host dns.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @adguard {
		reverse_proxy https://stp-adguard:3443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# Catch-all: cualquier subdominio sin IP válida → 403
	handle {
		respond "Acceso restringido. Conéctate a la VPN." 403
	}
}

{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

# ── Pasarela del tunnel para los botones de cotización (pública) ──────────────
# La landing vive en Vercel (repo stpsoluciones-landing); su vercel.json
# reenvía /erp-api/* aquí para que los enlaces de aprobar/rechazar de los
# correos (stpsoluciones.com/erp-api/...) sigan funcionando.
# SOLO la ruta exacta de decisión; todo lo demás 404.
http://gw.stpsoluciones.com {
	handle /erp-api/quotes/decision {
		uri strip_prefix /erp-api
		reverse_proxy stp-api:3001
	}

	handle {
		respond 404
	}
}

# ── Apps privadas — HTTPS wildcard, solo VPN (100.64.0.0/10) o LAN (10.0.0.0/8 · 192.168.0.0/16)
*.stpsoluciones.com {
	tls {
		dns cloudflare {env.CF_DNS_API_TOKEN}
	}

	# ERP Frontend
	@erp {
		host erp.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @erp {
		reverse_proxy stp-landing:3000
	}

	# ERP API (NestJS — para app móvil y acceso directo)
	@api {
		host api.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @api {
		reverse_proxy stp-api:3001
	}

	# Vaultwarden
	@vaultwarden {
		host vault.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @vaultwarden {
		reverse_proxy stp-vaultwarden:80
	}

	# Nextcloud
	@nextcloud {
		host cloud.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @nextcloud {
		reverse_proxy stp-nextcloud:80
	}

	# Uptime Kuma
	@uptime {
		host status.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @uptime {
		reverse_proxy stp-uptime-kuma:3001
	}

	# AdGuard
	@adguard {
		host dns.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @adguard {
		reverse_proxy https://stp-adguard:3443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# EstrucCalc RD Pro
	@estructural {
		host estructural.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @estructural {
		reverse_proxy estructural_nginx:80
	}

	# Immich — fotos (reemplazo Google Fotos / iCloud)
	@fotos {
		host fotos.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @fotos {
		reverse_proxy immich-server:2283
	}

	# Vigía — dashboard de monitoreo
	@vigia {
		host monitor.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @vigia {
		# Socket.io y API van al backend
		handle /socket.io/* {
			reverse_proxy vigia-backend:3002
		}
		handle /api/* {
			reverse_proxy vigia-backend:3002
		}
		# Todo lo demás al frontend Next.js
		reverse_proxy vigia-frontend:3000
	}

	# eCF-SaaS Frontend (facturación electrónica DGII — en desarrollo, futura integración al ERP)
	@ecf {
		host ecf.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @ecf {
		reverse_proxy ecf-frontend:3000
	}

	# eCF-SaaS API
	@ecfapi {
		host ecf-api.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @ecfapi {
		reverse_proxy ecf-api:3000
	}

	# Emparejamiento del puente de WhatsApp (Baileys) — página con el QR que se
	# auto-refresca, solo mientras se vincula la sesión. Ver whatsapp-bridge/.
	@whatsappqr {
		host whatsapp-qr.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @whatsappqr {
		reverse_proxy stp-whatsapp-bridge:3900
	}

	# STP Tickets — bugs/cambios/mejoras de todos los proyectos
	@tickets {
		host tickets.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @tickets {
		handle /api/* {
			reverse_proxy stp-tickets-api:3003
		}
		reverse_proxy stp-tickets-web:3000
	}

	# Descargas — APKs de las apps móviles internas (STP Tecnicos, etc.)
	@descargas {
		host apk.stpsoluciones.com
		remote_ip 100.64.0.0/10 10.0.0.0/8 192.168.0.0/16 172.16.0.0/12
	}
	handle @descargas {
		root * /srv/downloads
		file_server browse
	}

	# Mi Día — PWA personal de tareas/notas. Única app de esta lista que es
	# PÚBLICA a propósito (sin remote_ip): tiene su propio login (JWT) porque
	# no puede depender de la VPN para usarse desde el celular fuera de casa.
	@midia {
		host dia.stpsoluciones.com
	}
	handle @midia {
		handle /api/* {
			uri strip_prefix /api
			reverse_proxy mi-dia-api:3000
		}
		reverse_proxy mi-dia-frontend:80
	}

	# Catch-all: cualquier subdominio sin IP válida → 403
	handle {
		respond "Acceso restringido. Conéctate a la VPN." 403
	}
}
